{
  "package_version": "4.1.0",
  "custom_roles": [
    "code-reviewer",
    "debugger",
    "design-critic",
    "docs-researcher",
    "finding-validator",
    "test-author",
    "test-verifier"
  ],
  "built_in_roles": [
    "Explore",
    "general-purpose"
  ],
  "model_policy": {
    "display_name": "Gemini 3.8 Flash",
    "thoughtLevel": "high",
    "model_id": "set using your ZCode provider-id/model-id"
